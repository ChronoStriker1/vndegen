+    /**
+     * The movie's own context menu items, without Ruffle's and Flash Player's built-in ones, for a host that lists
+     * them in a menu of its own. Unlike the context menu, it lists them while the movie is suspended too.
+     *
+     * @returns Each item with its index for {@link runContextMenuItem}.
+     */
+    movieContextMenuItems(): MovieContextMenuItem[] {
+        return this.instance?.prepare_movie_context_menu() ?? [];
+    }
+
+    /**
+     * Chooses a context menu item that {@link movieContextMenuItems} listed.
+     *
+     * @param index The item's index.
+     */
+    async runContextMenuItem(index: number): Promise<void> {
+        await this.instance?.run_context_menu_callback(index);
+    }
+

diff --git a/web/src/lib.rs b/web/src/lib.rs
index df64fd833..6fae091af 100644
--- a/web/src/lib.rs
+++ b/web/src/lib.rs
@@ -387,6 +387,48 @@ impl RuffleHandle {
         .unwrap_or(JsValue::UNDEFINED)
     }
 
+    /// The movie's own context menu items, without the built-in ones such as Play and Quality, each with its index for
+    /// `run_context_menu_callback`. Prepares the menu as a right click does, so the movie's `onSelect` and
+    /// `menuSelect` handlers run first. For a host that lists them in a menu of its own.
+    pub fn prepare_movie_context_menu(&self) -> JsValue {
+        #[derive(Serialize)]
+        #[serde(rename_all = "camelCase")]
+        struct MovieContextMenuItem {
+            index: usize,
+            caption: String,
+            checked: bool,
+            enabled: bool,
+            separator_before: bool,
+        }
+
+        self.with_core_mut(|core| {
+            let info = core.prepare_context_menu();
+            let items: Vec<MovieContextMenuItem> = core.mutate_with_update_context(|context| {
+                let Some(menu) = context.current_context_menu.as_ref() else {
+                    return vec![];
+                };
+                info.iter()
+                    .enumerate()
+                    .filter(|(index, _)| {
+                        matches!(
+                            menu.callback(*index),
+                            ContextMenuCallback::Avm1 { .. } | ContextMenuCallback::Avm2 { .. }
+                        )
+                    })
+                    .map(|(index, item)| MovieContextMenuItem {
+                        index,
+                        caption: item.caption.clone(),
+                        checked: item.checked,
+                        enabled: item.enabled,
+                        separator_before: item.separator_before,
+                    })
+                    .collect()
+            });
+            serde_wasm_bindgen::to_value(&items).unwrap_or(JsValue::UNDEFINED)
+        })
+        .unwrap_or(JsValue::UNDEFINED)
+    }
+
     pub async fn run_context_menu_callback(&self, index: usize) {

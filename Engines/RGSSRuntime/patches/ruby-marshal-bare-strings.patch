--- a/marshal.c
+++ b/marshal.c
@@ -642,9 +642,14 @@
     return ST_CONTINUE;
 }
 
+/* VNDegen: RPG Maker XP and VX ran Ruby 1.8, whose Marshal wrote strings and symbols without an encoding. When this
+ * is set, dumps leave the encoding out, so the original engines read the saves. */
+int rb_marshal_rgss_bare_strings = 0;
+
 static VALUE
 encoding_name(VALUE obj, struct dump_arg *arg)
 {
+    if (rb_marshal_rgss_bare_strings) return Qnil;
     if (rb_enc_capable(obj)) {
         int encidx = rb_enc_get_index(obj);
         rb_encoding *enc = 0;
@@ -1597,6 +1602,10 @@
                      rb_enc_name(rb_enc_from_index(idx)), s);
         }
     }
+    else if (rb_marshal_rgss_bare_strings && !rb_enc_str_asciionly_p(s)) {
+        rb_enc_associate_index(s, rb_utf8_encindex());
+        if (is_broken_string(s)) rb_enc_associate_index(s, rb_ascii8bit_encindex());
+    }
 
     return s;
 }

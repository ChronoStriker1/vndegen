diff --git a/src/display/font.cpp b/src/display/font.cpp
index 11be0be..ae6cb7b 100644
--- a/src/display/font.cpp
+++ b/src/display/font.cpp
@@ -50,6 +50,13 @@
 #  include <SDL_ttf.h>
 #endif // MKXPZ_RETRO
 
+#ifdef MKXPZ_RETRO
+/* VNDegen: the Windows font substitutes in Engines/Shared/fonts, which the frontend links in. Writes the file of the
+ * substitute for a Windows font name, such as "MS PGothic", to `path` and its face index to `face`, and returns 1, or
+ * returns 0 when there is none. */
+extern "C" int vnrgss_font_substitute(const char *name, char *path, size_t size, int *face);
+#endif // MKXPZ_RETRO
+
 #include <ft2build.h>
 #include FT_FREETYPE_H
 #include FT_SFNT_NAMES_H
@@ -732,6 +739,20 @@ SharedFontState::getFont(Exception &exception, std::string family,
 	/* Find out if the font asset exists */
 	const FontSet &req = p->sets[family];
 
+#ifdef MKXPZ_RETRO
+	/* VNDegen: a Windows font the game doesn't ship opens from its substitute. Its pool key is its path, which no
+	 * family name starts with. */
+	std::string substitute;
+	int substituteFace = 0;
+	char substitutePath[1024];
+	if (req->empty() && vnrgss_font_substitute(family.c_str(), substitutePath, sizeof substitutePath, &substituteFace))
+	{
+		substitute = substitutePath;
+		Debug() << "VNDegen: font" << family << "uses" << substitute;
+		family = "\x01" + substitute;
+	}
+	else
+#endif // MKXPZ_RETRO
 	if (req->empty())
 	{
 		/* Doesn't exist; use built-in font */
@@ -771,7 +792,18 @@ SharedFontState::getFont(Exception &exception, std::string family,
 	/* Not in pool; open new handle */
 #ifdef MKXPZ_RETRO
 	boost::optional<SharedFontStatePrivate::PoolEntry> entry;
-	if (family.empty())
+	if (!substitute.empty())
+	{
+		entry = SharedFontStatePrivate::PoolEntry();
+		if (FT_New_Face(p->library, substitute.c_str(), substituteFace, &entry->font))
+		{
+			entry->font = nullptr;
+			p->size_to_ppem.remove(key);
+			exception = Exception(Exception::SDLError, "failed to load font");
+			return nullptr;
+		}
+	}
+	else if (family.empty())
 	{
 		entry = SharedFontStatePrivate::PoolEntry();
 		if (FT_New_Memory_Face(p->library, BNDL_F_D(BUNDLED_FONT), BNDL_F_L(BUNDLED_FONT), 0, &entry->font))
@@ -938,6 +970,13 @@ bool SharedFontState::fontPresent(std::string family) const
 
 	const FontSet &set = p->sets[family];
 
+#ifdef MKXPZ_RETRO
+	/* VNDegen: a Windows font with a substitute counts as present, as an installed font does on Windows. */
+	char path[1024];
+	int face;
+	if (set->empty())
+		return vnrgss_font_substitute(family.c_str(), path, sizeof path, &face);
+#endif // MKXPZ_RETRO
 	return !set->empty();
 }
 

+/* Archive paths are looked up ignoring ASCII case, as on Windows */
+static std::string
+lowerCase(const char *path)
+{
+	std::string lower(path);
+	for (size_t i = 0; i < lower.size(); ++i)
+		if (lower[i] >= 'A' && lower[i] <= 'Z')
+			lower[i] += 'a' - 'A';
+	return lower;
+}

+	ClassDB::_add_class(p_type, p_inherits, p_deinit_func);
 }
 
 void Object::_get_property_list_from_classdb(const StringName &p_class, List<PropertyInfo> *p_list, bool p_no_inheritance, const Object *p_validator) {
@@ -2571,6 +2576,11 @@ void ObjectDB::cleanup() {
 	if (object_slots) {
 		memfree(object_slots);
 	}
+	// VNDegen: the engine can start again in the same process. Leaked instances stay leaked, and validators keep
+	// counting up, so their old IDs never match a new instance.
+	object_slots = nullptr;
+	slot_count = 0;
+	slot_max = 0;
 
 	spin_lock.unlock();
 }

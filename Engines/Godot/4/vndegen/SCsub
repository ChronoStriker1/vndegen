#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")
Import("env_modules")

env_vndegen = env_modules.Clone()
# vngd.h lives with the Swift package that calls it.
env_vndegen.Prepend(CPPPATH=[Dir(".").srcnode().abspath + "/../../../../Packages/VNDegenKit/Sources/CGodot/include"])

sources = ["register_types.cpp", "vngd.cpp", "vngd_keys.cpp"]
if env["platform"] in ("macos", "ios"):
    sources += ["vngd_apple.mm", "display_server_vndegen.mm"]
    env_vndegen.Append(CCFLAGS=["-fobjc-arc"])
elif env["platform"] == "linuxbsd":
    sources += ["vngd_linuxbsd.cpp"]

env_vndegen.add_source_files(env.modules_sources, sources)

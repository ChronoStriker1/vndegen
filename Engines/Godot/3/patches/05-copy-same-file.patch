+// VNDegen: VNDegen finds files whatever case a game names them in, so two spellings can open one file on disk, and
+// copying it onto itself would empty it. A file read from a pack reports no disk path, so it never matches.
+static bool _vndegen_same_file(const String &p_a, const String &p_b) {
+	struct stat a, b;
+	return !p_a.empty() && !p_b.empty() && stat(p_a.utf8().get_data(), &a) == 0 && stat(p_b.utf8().get_data(), &b) == 0 && a.st_dev == b.st_dev && a.st_ino == b.st_ino;
+}

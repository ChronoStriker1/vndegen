project('angle-only', 'c', 'cpp', 'objc', default_options: ['default_library=static', 'buildtype=release'])
subproject('common', default_options: {'c_std': 'gnu11,c11', 'cpp_std': 'gnu++14,c++14'})
subproject('xxhash', default_options: {'default_library': 'static', 'c_std': 'gnu11,c11'})
meson.override_dependency('zlib', declare_dependency(link_args: ['-lz']))
angle = subproject('angle', default_options: {'default_library': 'static', 'c_std': 'gnu11,c11', 'cpp_std': 'gnu++14,c++14', 'direct3d11': 'disabled', 'metal': 'enabled', 'null': 'disabled', 'opengl': 'disabled', 'vulkan': 'disabled', 'wayland': 'disabled', 'x11': 'disabled'})

executable('rgss-harness', 'harness.m', 'vfs.c',
    dependencies: [angle.get_variable('angle_dep'), dependency('appleframeworks', modules: ['Foundation', 'ImageIO', 'CoreGraphics', 'Metal', 'IOSurface', 'QuartzCore'])],
    objc_args: ['-fobjc-arc'],
    link_args: ['-lc++'])
